# cmake -DMODE=check|fix -P ClangFormat.cmake. Formats C++ under this tree; honours .clang-format-ignore.
set(REQUIRED_MAJOR 23)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
find_program(CLANG_FORMAT clang-format)
if(NOT CLANG_FORMAT)
    message(FATAL_ERROR "clang-format not found. Install clang-format ${REQUIRED_MAJOR} and put it on PATH.")
endif()
execute_process(COMMAND "${CLANG_FORMAT}" --version OUTPUT_VARIABLE version)
if(NOT version MATCHES "version ${REQUIRED_MAJOR}\\.")
    message(FATAL_ERROR "clang-format ${REQUIRED_MAJOR}.x required (versions format differently); found: ${version}")
endif()
file(GLOB_RECURSE sources RELATIVE "${root}" "${root}/app/*.cpp" "${root}/app/*.h"
     "${root}/api/*.cpp" "${root}/api/*.h" "${root}/toolkit/*.cpp" "${root}/toolkit/*.h")
if(MODE STREQUAL "fix")
    execute_process(COMMAND "${CLANG_FORMAT}" --style=file -i ${sources} WORKING_DIRECTORY "${root}" RESULT_VARIABLE failed)
elseif(MODE STREQUAL "check")
    execute_process(COMMAND "${CLANG_FORMAT}" --style=file --dry-run --Werror ${sources}
                    WORKING_DIRECTORY "${root}" RESULT_VARIABLE failed)
    if(failed)
        message(FATAL_ERROR "C++ formatting differs from .clang-format. Fix: python3 tools/tablet.py format")
    endif()
else()
    message(FATAL_ERROR "Set -DMODE=check or -DMODE=fix")
endif()
if(failed)
    message(FATAL_ERROR "clang-format failed")
endif()

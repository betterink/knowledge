# Absolute path to the Obsidian vault folder on this host.
VAULT_PATH=/path/to/vault
# Host port for the backend.
PORT=8080
# Host address to bind; 0.0.0.0 exposes it to the LAN (no auth yet).
BIND_ADDRESS=127.0.0.1
# Run as the vault owner (UID:GID from `id -u`:`id -g`) if the vault is not world-readable.
# CONTAINER_USER=1000:1000
